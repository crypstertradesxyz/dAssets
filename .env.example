# dAssets Autonomous Keeper & Rebalancer Configuration
# Network: Robinhood Chain Mainnet (Chain ID: 4663)

# 1. Feeder Wallet Private Key (Required for on-chain writes)
# Use the private key of 0x6DcEa11430Ff757745f36a7197cb7Ea9FAF43935 (Authorized Feeder & Admin)
PRIVATE_KEY=your_feeder_private_key_here

# 2. Robinhood Chain RPC Endpoint
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# 3. Deployed MockRobinhoodOracle Contract Address
ORACLE_ADDRESS=0x0c19e8DE99BA135aBdc059b34e0d3F9E5e021fd0

# 4. Trigger Configuration
DEVIATION_THRESHOLD_PCT=0.25
HEARTBEAT_INTERVAL_MS=300000
POLL_INTERVAL_MS=20000
PORT=8080
